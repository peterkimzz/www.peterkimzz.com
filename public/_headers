# 파일 이름에 해시가 들어 있어 내용이 바뀌면 이름도 바뀐다. 1년 캐시해도 안전하다.
# /_nuxt/builds/*.json 은 새 배포 감지용이라 일부러 포함하지 않는다.
/_nuxt/*.js
  Cache-Control: public, max-age=31536000, immutable

/_nuxt/*.css
  Cache-Control: public, max-age=31536000, immutable

/_nuxt/*.woff2
  Cache-Control: public, max-age=31536000, immutable
