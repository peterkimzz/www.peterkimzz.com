{
  "name": "www-peterkimzz-com",
  "private": true,
  "type": "module",
  "scripts": {
    "add:image": "node scripts/add-image.mjs",
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "nuxt generate",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "new:post": "node scripts/new-post.mjs",
    "paste:image": "node scripts/paste-image.mjs",
    "preview": "nuxt preview",
    "preview:static": "serve .output/public -l 4173 --no-clipboard",
    "test:e2e": "yarn generate && playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:headed": "yarn generate && playwright test --headed",
    "typecheck": "nuxt prepare && nuxi typecheck"
  },
  "dependencies": {
    "@nuxt/content": "^3.10.0",
    "@nuxt/eslint": "1.12.1",
    "@nuxt/hints": "1.0.0-alpha.5",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxt/test-utils": "3.21.0",
    "@nuxt/ui": "4.3.0",
    "@nuxtjs/sitemap": "^7.4.7",
    "@tailwindcss/typography": "^0.5.18",
    "@unhead/vue": "^2.0.3",
    "better-sqlite3": "^12.5.0",
    "eslint": "^9.0.0",
    "medium-zoom": "^1.1.0",
    "nuxt": "^4.2.2",
    "typescript": "^5.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "serve": "^14.2.6",
    "vue-tsc": "^3.2.7"
  }
}
