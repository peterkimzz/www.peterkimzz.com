{
  "name": "www-peterkimzz-com",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "add:image": "node scripts/add-image.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "nuxt generate",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "new:post": "node scripts/new-post.mjs",
    "paste:image": "node scripts/paste-image.mjs",
    "postinstall": "node scripts/patch-nuxt-studio.mjs",
    "prebuild": "node scripts/prepare-build.mjs",
    "pregenerate": "node scripts/prepare-build.mjs",
    "prepare": "husky",
    "preview": "nuxt preview",
    "preview:ssr": "node .output/server/index.mjs",
    "preview:static": "serve .output/public -l 4173 --no-clipboard",
    "test:unit": "vitest run",
    "test:e2e": "cross-env-shell STUDIO_GITHUB_CLIENT_ID=test-client STUDIO_GITHUB_CLIENT_SECRET=test-secret STUDIO_GITHUB_MODERATORS=peterkimzz69@gmail.com STUDIO_GITHUB_REDIRECT_URL=http://127.0.0.1:4173/__nuxt_studio/auth/github NUXT_PUBLIC_SITE_URL=http://127.0.0.1:4173 \"yarn build && playwright test\"",
    "test:e2e:ci": "playwright test",
    "test:e2e:headed": "cross-env-shell STUDIO_GITHUB_CLIENT_ID=test-client STUDIO_GITHUB_CLIENT_SECRET=test-secret STUDIO_GITHUB_MODERATORS=peterkimzz69@gmail.com STUDIO_GITHUB_REDIRECT_URL=http://127.0.0.1:4173/__nuxt_studio/auth/github NUXT_PUBLIC_SITE_URL=http://127.0.0.1:4173 \"yarn build && playwright test --headed\"",
    "typecheck": "nuxt prepare && nuxi typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxt/content": "3.15.0",
    "@nuxt/eslint": "1.12.1",
    "@nuxt/hints": "1.0.0-alpha.5",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxt/test-utils": "3.21.0",
    "@nuxt/ui": "4.3.0",
    "@nuxtjs/sitemap": "^7.4.7",
    "@tailwindcss/typography": "^0.5.18",
    "@unhead/vue": "^2.0.3",
    "better-sqlite3": "^12.5.0",
    "eslint": "^9.0.0",
    "medium-zoom": "^1.1.0",
    "nuxt": "^4.2.2",
    "nuxt-studio": "1.7.0",
    "typescript": "^5.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "serve": "^14.2.6",
    "vitest": "3.2.4",
    "vue-tsc": "^3.2.7"
  }
}
